/* The Windows shell's own resources: its icon and the version block a person sees in Explorer.
 *
 * Both come from things that already exist: the icon from `tools/make_icon.py` (the design's own
 * shield mark, the same drawing the macOS and Linux builds use), and every string from the delivery's
 * VERSION file and `tools/brand.py` — filled in by app/windows/build_windows_app.sh through
 * `tools/fill_template.py --brand`. A template rather than macros: windres' preprocessor does not
 * join a macro with a string literal, and a name written twice by hand is a name that drifts.
 *
 * Round 302: the author and his address are here because the owner asked for them wherever the
 * program describes itself. Explorer shows "LegalCopyright" and "CompanyName"; the rest is what a
 * person sees in Properties → Details.
 */
#include <windows.h>

1 ICON "ProjectLife.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERNUM@
PRODUCTVERSION @VERNUM@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@AUTHOR@\0"
            VALUE "FileDescription", "@PRODUCT@ — @WHAT_IT_IS@\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "ProjectLife\0"
            VALUE "LegalCopyright", "@COPYRIGHT@. @LICENCE@ licence. Built without an Authenticode signature: this file is not signed and no publisher is claimed.\0"
            VALUE "OriginalFilename", "ProjectLife.exe\0"
            VALUE "ProductName", "@PRODUCT@\0"
            VALUE "ProductVersion", "@VERSION@\0"
            VALUE "Comments", "By @AUTHOR@ (@AUTHOR_EMAIL@). The window, the tray icon and the menu. It stores nothing itself: it drives projectlife-ui and projectlife, the same core the macOS and Linux builds use.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
